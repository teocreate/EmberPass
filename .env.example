# Copy to .env and adjust. Everything has a working default except DATABASE_URL.

# PostgreSQL connection string. Without it the server falls back to an in-memory
# store, which is fine for a demo but loses all data on restart.
# Локальная разработка:
# DATABASE_URL=postgres://pass:pass@localhost:5432/pass
# Supabase (Connect -> Connection String -> Session pooler), для постоянно
# работающего процесса; для serverless берите transaction pooler на порту 6543:
# DATABASE_URL=postgres://postgres.<ref>:<пароль>@aws-0-<регион>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# TLS для подключения к базе: auto (включён для всех хостов, кроме localhost),
# require, no-verify (шифрование без проверки цепочки), verify-full, disable.
# Хостингам вроде Supabase шифрование обязательно.
# DATABASE_SSL=auto
# DATABASE_CA_CERT=

# Размер пула соединений. По умолчанию 10, на serverless 2.
# DATABASE_POOL_MAX=10

PORT=3000
HOST=0.0.0.0

# Lifetime of a pass token, in seconds, and how often the holder app asks for a new
# one. Short lifetimes limit how long a screenshot of a pass stays useful.
PASS_TOKEN_TTL=30
PASS_TOKEN_REFRESH=12

# Session lifetime in seconds (12 hours by default).
SESSION_TTL=43200

# Set to true when serving over HTTPS so session cookies get the Secure flag.
SECURE_COOKIES=false

# Email verification at signup (see server/lib/email.js).
CHECK_EMAIL_MX=true
REJECT_DISPOSABLE_EMAIL=true

# Tolerance in seconds for clock differences between phone, gate and server.
CLOCK_SKEW=5

# Set to false to close public registration.
REGISTRATION_OPEN=true

# PDF417 as a second code format. Off by default: read off a phone screen it is far
# less forgiving than QR. Switch it on where turnstiles with laser scanners are
# installed - the encoder ships either way and is only downloaded when enabled.
# PASS_PDF417=true

# Where the Ed25519 signing key is stored. Generated on first start.
SIGNING_KEY_FILE=data/signing-key.json

# Alternative to the file above, and the only option on a read-only filesystem such
# as Vercel: the whole key as base64. Generate it with `npm run genkey`.
# SIGNING_KEY=eyJraWQiOjEsImNyZWF0ZWRBdCI6...

# --- Single sign-on (VoidAuth or any other OIDC provider) -------------------
# Leave OIDC_ISSUER empty to keep local email + password sign-in only.
#
# VoidAuth's issuer is its APP_URL plus /oidc. The app reads
# <issuer>/.well-known/openid-configuration and needs nothing else to be listed.
# OIDC_ISSUER=http://localhost:3000/oidc
# OIDC_CLIENT_ID=pass-app
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3001/api/auth/oidc/callback

# local: password form only. oidc: single sign-on only. both: the default when a
# provider is configured.
# AUTH_MODE=both

# Group names from the provider's `groups` claim that grant elevated roles.
# OIDC_STAFF_GROUPS=pass-staff
# OIDC_ADMIN_GROUPS=pass-admins

# Scopes to request, and how the client authenticates at the token endpoint.
# OIDC_SCOPE=openid profile email groups
# OIDC_AUTH_METHOD=client_secret_basic

# Attach a provider account to an existing local account with the same address.
# Only ever done when the provider reports the address as verified.
# OIDC_LINK_BY_EMAIL=true

# Sign out of the provider as well when signing out here.
# OIDC_RP_LOGOUT=true

# Button label on the sign-in screen.
# OIDC_DISPLAY_NAME=VoidAuth
